<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="DiseaseHIVD"/>
  <url value="https://demis.rki.de/fhir/StructureDefinition/DiseaseHIVD"/>
  <version value="1.1.0"/>
  <name value="DiseaseHIVD"/>
  <title value="Nichtnamentliche Ergänzung von Erkrankungsinformationen für HIV"/>
  <status value="active"/>
  <date value="2026-01-13"/>
  <description value="Die Condition-Ressource DiseaseHIVD spezifiziert die zu ergänzenden Erkrankungsinformationen wie z.B. Symptome hinsichtlich Humanes Immundefizienz-Virus (HIV)."/>
  <fhirVersion value="4.0.1"/>
  <mapping>
    <identity value="sct-concept"/>
    <uri value="http://snomed.info/conceptdomain"/>
    <name value="SNOMED CT Concept Domain Binding"/>
  </mapping>
  <mapping>
    <identity value="sct-attr"/>
    <uri value="http://snomed.org/attributebinding"/>
    <name value="SNOMED CT Attribute Binding"/>
  </mapping>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="Condition"/>
  <baseDefinition value="https://demis.rki.de/fhir/StructureDefinition/DiseaseNonNominal"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Condition.code">
      <path value="Condition.code"/>
      <short value="Meldetatbestand &quot;Humanes Immundefizienz-Virus (HIV)&quot;"/>
      <definition value="Bei Meldetatbestand &quot;Humanes Immundefizienz-Virus (HIV)&quot; ist Condition.code.coding.code mit &quot;hivd&quot; zu belegen."/>
    </element>
    <element id="Condition.code.coding.system">
      <path value="Condition.code.coding.system"/>
      <fixedUri value="https://demis.rki.de/fhir/CodeSystem/notificationDiseaseCategory"/>
    </element>
    <element id="Condition.code.coding.code">
      <path value="Condition.code.coding.code"/>
      <fixedCode value="hivd"/>
    </element>
    <element id="Condition.evidence">
      <path value="Condition.evidence"/>
      <max value="0" />
    </element>
  </differential>
</StructureDefinition>
